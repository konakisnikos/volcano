#version 330 core

// INPUTS (Must match your C++ VBO layout)
layout(location = 0) in vec3 vertexPosition_modelspace;
layout(location = 1) in vec3 vertexNormal_modelspace;
layout(location = 2) in vec2 aTexCoords;

// --- NEW INPUTS (The Map & The Rules) ---
layout(location = 3) in float inRiverMask; // 1.0 = River, 0.0 = Rock
layout(location = 4) in float inDist;      // Distance from crater (for animation)
// ----------------------------------------

// UNIFORMS
uniform mat4 M;
uniform mat4 V;
uniform mat4 P;
uniform vec3 light_position_worldspace; 
uniform float u_LavaTime;

// OUTPUTS to Fragment Shader
out vec4 vertex_position_cameraspace;
out vec4 vertex_normal_cameraspace;
out vec4 light_position_cameraspace;
out vec2 vTexCoord;

// --- NEW OUTPUTS (Passing data to the pixel painter) ---
out float vRiverMask;
out float vDist;
// -------------------------------------------------------

out vec3 vWorldPos;

void main() {
    float speed = 20.0;
    float flowHead = u_LavaTime * speed;
    float flowMask = 1.0 - smoothstep(flowHead, flowHead + 10.0, inDist);
    float riverBedMask = smoothstep(0.55, 0.9, inRiverMask);
    float lavaPresence = riverBedMask * flowMask;
    float liftMask = smoothstep(0.15, 0.85, lavaPresence);
    float liftAmount = 0.35 * liftMask;

    vec3 displacedPosition = vertexPosition_modelspace + vec3(0.0, liftAmount, 0.0);

    vec4 worldPos4 = M * vec4(displacedPosition, 1.0);
    vWorldPos = worldPos4.xyz;

    gl_Position =  P * V * M * vec4(displacedPosition, 1);

    vertex_position_cameraspace = V * M * vec4(displacedPosition, 1);
    vertex_normal_cameraspace = V * M * vec4(vertexNormal_modelspace, 0);
    light_position_cameraspace = V * vec4(light_position_worldspace, 1.0); 

    // Pass Texture Coordinates
    vTexCoord = aTexCoords;

    // --- PASS THE NEW DATA ---
    vRiverMask = inRiverMask;
    vDist = inDist;
}
