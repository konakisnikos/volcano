#version 330 core

// input vertex, UV coordinates and normal
layout(location = 0) in vec3 vertexPosition_modelspace;
layout(location = 1) in vec3 vertexNormal_modelspace;
layout(location = 2) in vec2 vertexUV;
layout (location = 3) in mat4 aInstanceMatrix;
layout (location = 7) in mat4 rotationMatrix;
layout (location = 11) in float scale;
layout (location = 12) in float life;


out vec2 UV;
out float vs_life;
flat out float vs_seed;
//out vec3 normal;

// Values that stay constant for the whole mesh.
uniform mat4 PV;
uniform vec2 uShapeScale;
uniform float uShear;

void main() {
    // vertex position

    UV = vertexUV;

    vs_life = life;

    // Stable per-particle seed.  Using the instance position means neighbouring
    // billboards do not all have the same outline, without adding another VBO.
    vec3 particlePosition = aInstanceMatrix[3].xyz;
    vs_seed = fract(sin(dot(particlePosition, vec3(12.9898, 78.233, 37.719)))
                    * 43758.5453);


    vec3 shapedPosition = vertexPosition_modelspace;
    shapedPosition.xy *= uShapeScale;
    shapedPosition.x += shapedPosition.y * uShear;
    gl_Position = PV * aInstanceMatrix * rotationMatrix * vec4(shapedPosition * scale, 1);

}
