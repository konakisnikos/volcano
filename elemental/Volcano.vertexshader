#version 330 core

layout(location = 0) in vec3 vertexPosition_modelspace;
layout(location = 1) in vec3 vertexNormal_modelspace; // kept for compatibility, unused
layout(location = 2) in vec2 aTexCoords;              // kept for compatibility, unused

uniform mat4 M; // model
uniform mat4 V; // view
uniform mat4 P; // projection

out vec3 vColor;

void main() {
    mat4 MVP = P * V * M;
    gl_Position = MVP * vec4(vertexPosition_modelspace, 1.0);

    // Simple height-based color: map y to 0..1 and expand to RGB
    float h = clamp((M * vec4(vertexPosition_modelspace, 1.0)).y / 5.0, 0.0, 1.0);
    vColor = vec3(h); // grayscale based on height
}
